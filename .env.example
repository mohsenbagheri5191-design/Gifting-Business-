# Copy to .env.local (development) or set in your host's dashboard (production).
# Everything is optional in development — the site runs with sensible defaults.

# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # your real domain in production, e.g. https://keepsake.ca
NEXT_PUBLIC_SUPPORT_EMAIL=hello@keepsake.example    # shown on the site and in emails
NEXT_PUBLIC_SUPPORT_PHONE=(416) 555-0199
NEXT_PUBLIC_CORPORATE_EMAIL=corporate@keepsake.example
# Months a gift stays valid. 0 = never expires (default; Ontario generally forbids expiry dates on gift cards).
NEXT_PUBLIC_CERTIFICATE_VALID_MONTHS=0

# ------------------------------------------------------------ database
# Leave empty in development: an embedded Postgres (PGlite) is stored in ./.data/pglite.
# In production use any Postgres (Neon, Supabase, Render, Railway, RDS…). POSTGRES_URL is also accepted.
# DATABASE_URL=postgres://user:password@host:5432/keepsake
# Set to false once you've replaced the sample catalog and don't want it re-created on an empty database.
SEED_SAMPLE_DATA=true

# ------------------------------------------------------------ payments
# Without a Stripe key the site runs in TEST MODE (simulated payments).
# STRIPE_SECRET_KEY=sk_live_...            # or sk_test_... while testing
# STRIPE_WEBHOOK_SECRET=whsec_...          # webhook endpoint: https://YOUR-DOMAIN/api/payments/stripe/webhook
# In production, test mode is OFF unless you explicitly allow it (e.g. for a private preview):
# ALLOW_TEST_PAYMENTS=true

# --------------------------------------------------------------- email
# Without SMTP, emails are stored and shown in Admin → Emails instead of being sent.
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.postmarkapp.com:465
# MAIL_FROM="Keepsake <hello@yourdomain.ca>"
# ADMIN_NOTIFY_EMAIL=orders@yourdomain.ca  # get notified of new orders, bookings and enquiries

# --------------------------------------------------------------- admin
# Development password is "keepsake-admin". In production the admin stays locked until this is set.
# ADMIN_PASSWORD=choose-a-long-passphrase
# SESSION_SECRET=a-long-random-string

# ----------------------------------------------------- background jobs
# Long-running servers send scheduled e-certificates automatically every minute.
# On serverless hosts (e.g. Vercel), call GET /api/cron/tick every minute with this bearer token:
# CRON_SECRET=another-long-random-string
